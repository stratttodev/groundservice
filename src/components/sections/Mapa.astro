---
import { MapPoint, Location } from "reicon-react";
import { CONTACT } from "../../lib/constants";

const mapsUrl = "https://maps.app.goo.gl/7zx7HZ2CBTiU1YVQ8";
---

<section id="mapa" class="relative h-auto md:h-[80vh]">
  <div id="map" class="absolute inset-0 w-full h-full md:h-200 z-0"></div>

  <div class="relative z-20 max-w-7xl mx-auto px-6 py-16 md:py-0 md:absolute md:inset-0 flex items-center pointer-events-none">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-16 w-full">
      <div class="hidden md:block"></div>

      <div class="flex flex-col justify-center pointer-events-auto">
        <div class="backdrop-blur-sm rounded-2xl p-6 md:p-8 lg:p-10 shadow-xl">
          <p class="font-body text-xs uppercase tracking-[0.2em] text-gs-ink/40 mb-4">Encuéntranos</p>
          <h2 class="font-display font-normal text-4xl md:text-6xl leading-tight text-gs-ink mb-6">
            Estamos en<br />
            <span class="text-gs-crimson">Calama</span>
          </h2>

          <div class="flex items-start gap-3 mb-6">
            <div class="w-10 h-10 bg-gs-crimson rounded-full flex items-center justify-center shrink-0 mt-1">
              <MapPoint size={18} className="text-white" weight="Filled" />
            </div>
            <p class="font-body text-gs-ink/70 text-sm leading-relaxed">
              {CONTACT.address}
            </p>
          </div>

          <div class="flex flex-col sm:flex-row gap-4">
            <a
              href={mapsUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 bg-gs-crimson text-white px-6 py-3 rounded-xl font-body text-sm uppercase tracking-wider hover:bg-gs-crimson/90 transition-colors"
            >
              <Location size={16} weight="Filled" />
              Cómo llegar
            </a>
            <a
              href="/contacto"
              class="inline-flex items-center justify-center gap-2 border border-gs-ink/20 text-gs-ink px-6 py-3 rounded-xl font-body text-sm uppercase tracking-wider hover:bg-gs-ink/5 transition-colors"
            >
              Conversemos
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  :global(.mapboxgl-control-container) {
    display: none;
  }
</style>

<script>
  const initMap = () => {
    const mapEl = document.getElementById("map");
    if (!mapEl || mapEl.dataset.initialized) return;

    const token = import.meta.env.PUBLIC_MAPBOX_TOKEN;

    if (!token) {
      console.warn(
        "[GroundService] Falta PUBLIC_MAPBOX_TOKEN — mapa no disponible.",
      );
      mapEl.innerHTML = `
        <div class="w-full h-full flex items-center justify-center bg-gs-ink text-white/30 font-body text-sm">
          Mapa no disponible — configure PUBLIC_MAPBOX_TOKEN
        </div>`;
      return;
    }

    mapEl.dataset.initialized = "true";

    import("mapbox-gl").then((mapboxgl) => {
      import("mapbox-gl/dist/mapbox-gl.css");

      mapboxgl.default.accessToken = token;

      const isMobile = window.innerWidth < 768;
      const mapCenter: [number, number] = isMobile
        ? [-68.880, -22.430]
        : [-68.890, -22.43];

      const map = new mapboxgl.Map({
        container: "map",
        style: "mapbox://styles/mapbox/light-v11",
        center: mapCenter,
        zoom: 13,
        bearing: -105.76625813163997,
        pitch: 76.4993981639761,
        scrollZoom: false,
        boxZoom: false,
        doubleClickZoom: false,
        touchZoomRotate: false,
      });

      new mapboxgl.Marker({ color: "#FF073A" })
        .setLngLat([-68.8551275, -22.4424573]) // ojo: esta es la coord del pin, no del center
        .addTo(map);
    });
  };

  document.addEventListener("astro:page-load", initMap);
  initMap();
</script>
