---
import { ShieldCheck, Timer, ClipboardList } from "reicon-react";
import { ABOUT_CARDS } from "../../lib/constants";

const iconMap = { ShieldCheck, Timer, ClipboardList };
---

<section id="nosotros" class="py-10 md:py-24 bg-white scroll-mt-32">
  <div class="max-w-7xl mx-auto px-6">
    <p class="font-body text-xs uppercase tracking-[0.2em] text-gs-ink/40 mb-4">Nosotros</p>

    <h2 class="font-display font-normal text-4xl md:text-5xl leading-tight mb-4">
      Ingeniería aplicada<br />
      a la <span class="text-gs-crimson">continuidad_</span> en terreno
    </h2>

    <p class="font-body text-gs-ink/50 text-lg max-w-2xl mb-16">
      No solo intervenimos equipos. Garantizamos que la operación no se detenga.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 items-start">
      {ABOUT_CARDS.map((card) => {
        const Icon = iconMap[card.icon];
        return (
          <div class="about-card rounded-xl p-8 bg-stone-100 text-gs-ink transition-all duration-300 cursor-pointer">
            <Icon size={36} className="mb-6 card-icon" />
            <h3 class="font-display font-normal text-xl mb-4">{card.title}</h3>
            <div class="flex flex-wrap gap-2">
              {card.tags.map((tag) => (
                <span class="tag text-xs font-body uppercase tracking-wider px-3 py-1 rounded-full bg-white text-gs-ink/70 border border-gs-ink/10 transition-all duration-300">
                  {tag}
                </span>
              ))}
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>

<style>
  .about-card:hover {
    background-color: var(--color-gs-crimson);
    color: white;
    transform: scale(1.06);
    box-shadow: 0 25px 60px -10px rgba(255, 7, 58, 0.4);
  }
  .about-card:hover .tag {
    border-color: rgba(255, 255, 255, 0.3);
    color: var(--color-gs-ink);
    background-color: white;
  }
  .about-card .card-icon {
    transition: transform 0.3s ease;
  }
  .about-card:hover .card-icon {
    transform: scale(1.15);
  }
</style>
