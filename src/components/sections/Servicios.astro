---
import ServiceCard from "../ui/ServiceCard.astro";
import logoEquipment from "../icons/logoEquipment.astro";
import logoMaintenance from "../icons/logoMaintenance.astro";
import logoSupplies from "../icons/logoSupplies.astro";
import logoRepairs from "../icons/logoRepairs.astro";
import { SERVICES } from "../../lib/constants";


const iconMap = { logoEquipment, logoMaintenance, logoSupplies, logoRepairs };
---

<section id="servicios" class="py-24 bg-white scroll-mt-32">
  <div class="max-w-7xl mx-auto">
    <p class="font-body text-xs uppercase tracking-[0.2em] text-gs-ink/30 mb-3">Servicios</p>

    <h2 class="font-display font-normal text-4xl md:text-5xl leading-tight text-gs-ink mb-6">
      Ecosistema modular de<br />
      soluciones para <span class="text-gs-crimson">_faena</span>
    </h2>

    <p class="font-body text-gs-ink/50 max-w-2xl mb-4">
      Estructuramos nuestra oferta en 4 divisiones especializadas.
    </p>

    <p class="font-body text-gs-ink/30 max-w-3xl mb-20 leading-relaxed">
      Cada unidad opera bajo autonomía técnica y cumplimiento estricto, integrándose según el requerimiento de tu contrato.
    </p>

    <div class="grid grid-cols-1 lg:grid-col gap-6">
      {SERVICES.map((service) => {
        const Icon = iconMap[service.icon];
        return (
          <ServiceCard
            description={service.description}
            tags={service.tags}
            bg={service.bg}
            cta={service.cta}
          >
            <Icon slot="icon" class="w-80 h-auto" />
          </ServiceCard>
        );
      })}
    </div>
  </div>
</section>
