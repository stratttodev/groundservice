---
import { VectorSquare } from "reicon-react";
import HeroShape01 from "../icons/heroShape01.astro";
import HeroShape02 from "../icons/heroShape02.astro";
---

<section id="hero" class="relative h-full flex flex-col justify-center overflow-hidden">
  <video
    src="/groundHeroBg.mp4"
    autoplay
    loop
    muted
    playsinline
    preload="metadata"
    class="absolute inset-0 w-full h-full object-cover"
  >
  </video>
  <div class="absolute inset-0 bg-gs-ink/30"></div>

  <HeroShape01 class="absolute -top-10 -left-20 h-auto z-10 mix-blend-screen opacity-40" />
  <HeroShape02 class="absolute -bottom-10 -right-30 h-auto z-10 mix-blend-screen opacity-40" />

  <div class="relative z-10 max-w-8xl mx-auto px-6 w-full flex-1 flex items-center">
    <div class="w-full">
      <span class="flex md:hidden font-body text-sm uppercase tracking-[0.2em] text-white bg-gs-crimson rounded-full px-4 py-2 items-center gap-2 mb-6 justify-center">
        <VectorSquare size={24} weight="Filled" />
        Sitio en construcción
      </span>
      <h1 class="font-display font-normal leading-[0.85]">
        <span class="block text-center md:text-left md:absolute md:left-0 md:top-1/2 md:-translate-y-1/2 text-white text-[5rem] sm:text-[6rem] md:text-[12rem] lg:text-[16rem]">Ground</span>
        <span class="block text-center md:text-left md:absolute md:right-0 md:top-1/2 md:translate-y-[20%] text-white text-[5rem] sm:text-[6rem] md:text-[12rem] lg:text-[16rem] mt-8 md:mt-0">Service</span>
      </h1>
    </div>
  </div>
</section>
