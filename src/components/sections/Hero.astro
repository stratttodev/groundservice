---
import { ArrowDown } from "reicon-react";
import HeroShape01 from "../icons/heroShape01.astro";
import HeroShape02 from "../icons/heroShape02.astro";
---

<section id="hero" class="relative min-h-screen flex flex-col justify-between overflow-hidden bg-linear-to-b from-red-100 to-white">
  <HeroShape01 class="absolute -top-10 -left-20 h-auto" />
  <HeroShape02 class="absolute -bottom-10 -right-30 h-auto" />

  <div class="relative z-10 max-w-8xl mx-auto px-6 pt-32 w-full flex-1 flex items-center">
    <div class="w-full">
      <h1 class="font-display font-normal text-[8rem] md:text-[12rem] lg:text-[16rem] leading-[0.85]">
        <span class="absolute left-0 top-60 text-gs-ink">Ground</span>
        <span class="absolute right-0 bottom-40 text-gs-ink">Service</span>
      </h1>
    </div>
  </div>

  <div class="relative z-10 max-w-7xl mx-auto px-6 pb-12 w-full">
    <div class="flex flex-col items-center gap-3">
      <div class="w-12 h-12 rounded-full border border-gs-ink/20 flex items-center justify-center animate-bounce">
        <ArrowDown size={20} className="text-gs-ink" />
      </div>
      <span class="text-gs-ink/40 text-sm font-body">Scrollear para saber más</span>
    </div>
  </div>
</section>

<style>
  .animate-bounce {
    animation: bounce 2s infinite;
  }
  @keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-8px); }
  }
</style>
