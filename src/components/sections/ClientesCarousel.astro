---
import { CLIENTS } from "../../lib/constants";
const items = [...CLIENTS, ...CLIENTS, ...CLIENTS];
---

<section id="clientes" class="py-16 bg-white overflow-hidden">
  <div class="max-w-7xl mx-auto px-6 mb-8">
    <p class="font-body text-xs uppercase tracking-[0.2em] text-gs-ink/40">Confiaron en GS</p>
  </div>

  <div class="relative">
    <div class="marquee flex gap-12 items-center">
      {items.map((client) => (
        <img
          src={client.logo}
          alt={client.name}
          class="h-10 md:h-14 object-contain shrink-0 opacity-40 hover:opacity-70 transition-opacity"
          loading="lazy"
        />
      ))}
    </div>

    <div class="absolute inset-y-0 left-0 w-24 bg-gradient-to-r from-white to-transparent pointer-events-none"></div>
    <div class="absolute inset-y-0 right-0 w-24 bg-gradient-to-l from-white to-transparent pointer-events-none"></div>
  </div>
</section>

<style>
  .marquee {
    animation: scroll 30s linear infinite;
  }
  @keyframes scroll {
    0% { transform: translateX(0); }
    100% { transform: translateX(-33.333%); }
  }
</style>
