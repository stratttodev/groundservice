---
import { Message } from "reicon-react";
import { NAV_LINKS, COMPANY } from "../../lib/constants";
---

<nav class="fixed top-0 left-0 right-0 z-50 bg-gs-ink/90 backdrop-blur-sm border-b border-white/10">
  <div class="max-w-7xl mx-auto px-6 h-16 flex items-center justify-between">
    <a href="#" class="flex items-center gap-2">
      <div class="w-8 h-8 rounded-full bg-gs-crimson flex items-center justify-center">
        <span class="text-white font-display font-bold text-sm">GS</span>
      </div>
      <span class="font-display font-bold text-white text-lg">{COMPANY.name}</span>
    </a>

    <div class="hidden md:flex items-center gap-8">
      {NAV_LINKS.map((link) => (
        <a
          href={link.href}
          class="text-sm font-body uppercase tracking-widest text-white/60 hover:text-white transition-colors"
        >
          {link.label}
        </a>
      ))}
      <a
        href="#contacto"
        class="inline-flex items-center gap-2 bg-gs-crimson text-white px-5 py-2 text-sm font-body uppercase tracking-wider rounded hover:bg-gs-crimson/90 transition-colors"
      >
        Conversemos
        <Message size={16} />
      </a>
    </div>

    <button id="menu-toggle" class="md:hidden text-white" aria-label="Menú">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M3 12h18M3 6h18M3 18h18" />
      </svg>
    </button>
  </div>

  <div id="mobile-menu" class="hidden md:hidden bg-gs-ink border-t border-white/10 px-6 py-4">
    {NAV_LINKS.map((link) => (
      <a
        href={link.href}
        class="block py-2 text-sm font-body uppercase tracking-widest text-white/60 hover:text-white transition-colors"
      >
        {link.label}
      </a>
    ))}
    <a
      href="#contacto"
      class="mt-3 inline-flex items-center gap-2 bg-gs-crimson text-white px-5 py-2 text-sm font-body uppercase tracking-wider rounded"
    >
      Conversemos
      <Message size={16} />
    </a>
  </div>
</nav>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  toggle?.addEventListener("click", () => menu?.classList.toggle("hidden"));
</script>
