---
import { VectorSquare } from "reicon-react";
import { COMPANY } from "../../lib/constants";
import Isotype from "../ui/Isotype.astro";
---

<nav class="absolute top-0 left-0 right-0 z-20 w-full">
  <div class="max-w-7xl mx-auto py-8 px-6 flex flex-col md:flex-row items-center justify-between gap-4 md:gap-0">
    <a href="/" class="flex items-center gap-2">
      <Isotype class="w-10 h-10 text-gs-crimson" />
      <span class="font-display font-normal text-white text-2xl">{COMPANY.name}</span>
    </a>

    <span class="hidden md:flex font-body text-sm uppercase tracking-[0.2em] text-white bg-gs-crimson rounded-full px-4 py-2 items-center gap-2">
      <VectorSquare size={24} weight="Filled" />
      Sitio en construcción
    </span>
  </div>
</nav>
