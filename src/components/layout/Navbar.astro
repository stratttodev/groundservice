---
import { ChatLine, Instagram, Globe } from "reicon-react";
import { NAV_LINKS, COMPANY } from "../../lib/constants";
import Isotype from "../ui/Isotype.astro";

const currentPath = Astro.url.pathname;
---

<nav id="navbar" class="fixed top-0 left-0 right-0 z-[60] bg-transparent transition-all duration-300">
  <div id="nav-container" class="max-w-7xl mx-auto py-16 px-6 flex items-center justify-between transition-all duration-300">
    <a href="/" id="nav-logo" class="flex items-center gap-2 transition-all duration-500 ease-[cubic-bezier(0.4,0,0.2,1)]" transition:name="logo" transition:animate="slide">
      <Isotype id="nav-isotype" class="w-12 h-12 text-gs-crimson transition-all duration-300" transition:name="logo-isotype" transition:animate="slide" />
      <span id="nav-name" class="font-display font-normal text-gs-ink text-3xl transition-all duration-300" transition:name="logo-text" transition:animate="slide">{COMPANY.name}</span>
    </a>

    <div class="hidden md:flex items-center gap-8">
      {NAV_LINKS.map((link) => {
        const isContactoOnContacto = currentPath === "/contacto" && link.href === "#contacto";
        return (
          <a
            href={isContactoOnContacto ? "/" : link.href}
            class:list={[
              "text-sm font-body uppercase tracking-widest transition-colors",
              currentPath === "/" && link.href === "#contacto"
                ? "text-gs-ink font-semibold"
                : currentPath === "/contacto" && link.label === "Contacto"
                  ? "text-gs-ink font-semibold"
                  : "text-gs-ink/60 hover:text-gs-ink",
            ]}
            data-nav-link={link.href.replace("#", "")}
          >
            {link.label}
          </a>
        );
      })}
      {currentPath === "/" && (
        <a
          href="#contacto"
          class="inline-flex items-center gap-2 bg-gs-crimson text-white px-6 py-3 text-sm font-display uppercase tracking-wider rounded-lg hover:bg-gs-crimson/90 transition-colors"
        >
          <ChatLine size={24} weight="Filled" />
          Conversemos!
        </a>
      )}
    </div>

    <button id="menu-toggle" class="md:hidden relative w-10 h-10 flex items-center justify-center text-gs-ink" aria-label="Menú">
      <span id="icon-menu" class="absolute transition-all duration-500 ease-[cubic-bezier(0.4,0,0.2,1)]">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </span>
      <span id="icon-close" class="absolute opacity-0 scale-0 rotate-90 transition-all duration-500 ease-[cubic-bezier(0.4,0,0.2,1)]">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M18 6L6 18M6 6l12 12" />
        </svg>
      </span>
    </button>
  </div>
</nav>

<div id="mobile-menu" class="fixed inset-0 z-[55] flex flex-col items-center justify-center opacity-0 pointer-events-none transition-all duration-500 ease-[cubic-bezier(0.4,0,0.2,1)]">
  <div class="absolute inset-0 bg-white/80 backdrop-blur-xl"></div>

  <div id="menu-content" class="relative flex flex-col items-center gap-10">
    {NAV_LINKS.map((link, i) => {
      const isContactoOnContacto = currentPath === "/contacto" && link.href === "#contacto";
      return (
        <a
          href={isContactoOnContacto ? "/" : link.href}
          class="menu-link font-display font-normal text-4xl md:text-5xl text-gs-ink hover:text-gs-crimson opacity-0 translate-y-6 scale-95"
          data-nav-link={link.href.replace("#", "")}
          style={`transition: opacity 0.5s cubic-bezier(0.4,0,0.2,1) ${i * 70}ms, transform 0.5s cubic-bezier(0.34,1.56,0.64,1) ${i * 70}ms, color 0.3s ease;`}
        >
          {link.label}
        </a>
      );
    })}
    {currentPath === "/" && (
      <a
        href="#contacto"
        class="menu-link mt-2 inline-flex items-center gap-3 bg-gs-crimson text-white px-8 py-4 text-lg font-display uppercase tracking-wider rounded-xl hover:bg-gs-crimson/90 opacity-0 translate-y-6 scale-95"
        style={`transition: opacity 0.5s cubic-bezier(0.4,0,0.2,1) ${NAV_LINKS.length * 70 + 60}ms, transform 0.5s cubic-bezier(0.34,1.56,0.64,1) ${NAV_LINKS.length * 70 + 60}ms, background-color 0.3s ease;`}
      >
        <ChatLine size={24} weight="Filled" />
        Conversemos!
      </a>
    )}
  </div>

  <div class="absolute bottom-10 left-0 right-0 flex justify-center items-center gap-6">
    <a href="#" aria-label="LinkedIn" class="menu-social text-gs-ink/40 hover:text-gs-ink opacity-0 translate-y-4" style={`transition: opacity 0.5s cubic-bezier(0.4,0,0.2,1) ${(NAV_LINKS.length + 1) * 70 + 120}ms, transform 0.5s cubic-bezier(0.34,1.56,0.64,1) ${(NAV_LINKS.length + 1) * 70 + 120}ms, color 0.3s ease;`}>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
        <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
      </svg>
    </a>
    <a href="#" aria-label="Instagram" class="menu-social text-gs-ink/40 hover:text-gs-ink opacity-0 translate-y-4" style={`transition: opacity 0.5s cubic-bezier(0.4,0,0.2,1) ${(NAV_LINKS.length + 1) * 70 + 180}ms, transform 0.5s cubic-bezier(0.34,1.56,0.64,1) ${(NAV_LINKS.length + 1) * 70 + 180}ms, color 0.3s ease;`}>
      <Instagram size={24} />
    </a>
    <a href="#" aria-label="GitHub" class="menu-social text-gs-ink/40 hover:text-gs-ink opacity-0 translate-y-4" style={`transition: opacity 0.5s cubic-bezier(0.4,0,0.2,1) ${(NAV_LINKS.length + 1) * 70 + 240}ms, transform 0.5s cubic-bezier(0.34,1.56,0.64,1) ${(NAV_LINKS.length + 1) * 70 + 240}ms, color 0.3s ease;`}>
      <Globe size={24} />
    </a>
  </div>
</div>

<script>
  const setupNavbar = () => {
    const navbar = document.getElementById("navbar");
    const container = document.getElementById("nav-container");
    const isotype = document.getElementById("nav-isotype");
    const name = document.getElementById("nav-name");
    const logo = document.getElementById("nav-logo");
    const toggle = document.getElementById("menu-toggle");
    const iconMenu = document.getElementById("icon-menu");
    const iconClose = document.getElementById("icon-close");
    const mobileMenu = document.getElementById("mobile-menu");
    const menuLinks = mobileMenu?.querySelectorAll(".menu-link");
    const menuSocials = mobileMenu?.querySelectorAll(".menu-social");

    let isOpen = false;

    const animateIn = (el: Element, delay: number) => {
      setTimeout(() => {
        el.classList.remove("translate-y-6", "opacity-0", "scale-95", "translate-y-4");
        el.classList.add("translate-y-0", "opacity-100", "scale-100");
      }, delay);
    };

    const openMenu = () => {
      isOpen = true;
      navbar?.classList.remove("bg-white", "shadow-xs");
      mobileMenu?.classList.remove("opacity-0", "pointer-events-none");
      mobileMenu?.classList.add("opacity-100", "pointer-events-auto");
      iconMenu?.classList.add("opacity-0", "scale-0", "-rotate-90");
      iconMenu?.classList.remove("opacity-100", "scale-100", "rotate-0");
      iconClose?.classList.remove("opacity-0", "scale-0", "rotate-90");
      iconClose?.classList.add("opacity-100", "scale-100", "rotate-0");
      logo?.classList.add("opacity-0", "scale-95", "-translate-x-2");
      logo?.classList.remove("opacity-100", "scale-100", "translate-x-0");
      document.body.style.overflow = "hidden";

      menuLinks?.forEach((link, i) => animateIn(link, 80 + i * 70));
      menuSocials?.forEach((s, i) => animateIn(s, 80 + (menuLinks?.length ?? 0) * 70 + 120 + i * 60));
    };

    const closeMenu = () => {
      isOpen = false;
      iconClose?.classList.add("opacity-0", "scale-0", "rotate-90");
      iconClose?.classList.remove("opacity-100", "scale-100", "rotate-0");
      iconMenu?.classList.remove("opacity-0", "scale-0", "-rotate-90");
      iconMenu?.classList.add("opacity-100", "scale-100", "rotate-0");
      logo?.classList.remove("opacity-0", "scale-95", "-translate-x-2");
      logo?.classList.add("opacity-100", "scale-100", "translate-x-0");

      menuLinks?.forEach((link) => {
        link.classList.add("opacity-0", "translate-y-6", "scale-95");
        link.classList.remove("translate-y-0", "opacity-100", "scale-100");
      });
      menuSocials?.forEach((s) => {
        s.classList.add("opacity-0", "translate-y-4");
        s.classList.remove("translate-y-0", "opacity-100");
      });

      setTimeout(() => {
        mobileMenu?.classList.add("opacity-0", "pointer-events-none");
        mobileMenu?.classList.remove("opacity-100", "pointer-events-auto");
        document.body.style.overflow = "";
        applyScrollState();
      }, 200);
    };

    toggle?.addEventListener("click", () => {
      isOpen ? closeMenu() : openMenu();
    });

    mobileMenu?.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", closeMenu);
    });

    const applyScrollState = () => {
      if (isOpen) return;
      if (window.scrollY > 50) {
        navbar?.classList.add("bg-white", "shadow-xs");
        navbar?.classList.remove("bg-transparent");
        container?.classList.add("py-8");
        container?.classList.remove("py-16");
        isotype?.classList.add("w-10", "h-10");
        isotype?.classList.remove("w-12", "h-12");
        name?.classList.add("text-2xl");
        name?.classList.remove("text-3xl");
      } else {
        navbar?.classList.remove("bg-white", "shadow-xs");
        navbar?.classList.add("bg-transparent");
        container?.classList.remove("py-8");
        container?.classList.add("py-16");
        isotype?.classList.remove("w-10", "h-10");
        isotype?.classList.add("w-12", "h-12");
        name?.classList.remove("text-2xl");
        name?.classList.add("text-3xl");
      }
    };

    applyScrollState();
    window.removeEventListener("scroll", applyScrollState);
    window.addEventListener("scroll", applyScrollState);

    const sections = ["manifesto", "nosotros", "servicios", "contacto"];
    const isIndex = window.location.pathname === "/";

    if (isIndex) {
      const links = document.querySelectorAll("[data-nav-link]");
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const id = entry.target.id;
              links.forEach((link) => {
                if (link.getAttribute("data-nav-link") === id) {
                  link.classList.add("font-semibold", "text-gs-ink");
                  link.classList.remove("text-gs-ink/60");
                } else {
                  link.classList.remove("font-semibold", "text-gs-ink");
                  link.classList.add("text-gs-ink/60");
                }
              });
            }
          });
        },
        { rootMargin: "-40% 0px -55% 0px" }
      );

      sections.forEach((id) => {
        const el = document.getElementById(id);
        if (el) observer.observe(el);
      });
    }
  };

  setupNavbar();
  document.addEventListener("astro:after-swap", setupNavbar);
</script>
