---
import { Instagram } from "reicon-react";
import { COMPANY } from "../../lib/constants";
import Isotype from "../ui/Isotype.astro";
---

<footer class="absolute bottom-0 left-0 right-0 z-20 w-full py-10" transition:animate="fade">
  <div class="max-w-7xl mx-auto px-6">
    <div class="flex flex-col items-center md:flex-row md:items-center md:justify-between gap-4 md:gap-3">
      <div class="flex flex-col md:flex-row items-center gap-3 md:gap-3">
        <Isotype class="w-12 h-12 md:w-10 md:h-10 text-white" />
        <p class="text-xs md:text-base font-body text-white/70 text-center md:text-left">
          Copyright &copy; 2026 {COMPANY.name}. Todos los derechos reservados.
        </p>
      </div>

      <div class="flex items-center gap-4">
        <a href="/" aria-label="Instagram" class="text-white hover:text-white transition-colors" data-astro-reload>
          <Instagram size={24} weight="Filled" />
        </a>
      </div>
    </div>
  </div>
</footer>
