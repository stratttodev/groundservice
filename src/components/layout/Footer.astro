---
import { Instagram, Globe } from "reicon-react";
import { COMPANY } from "../../lib/constants";
import Isotype from "../ui/Isotype.astro";

interface Props {
  overlay?: boolean;
}

const { overlay = false } = Astro.props;
---

<footer class:list={[
  "relative py-6 md:py-8 transition-all",
  overlay
    ? "md:absolute md:bottom-0 md:left-0 md:right-0 z-10 bg-white md:bg-transparent border-t md:border-0 border-gs-ink/10"
    : "bg-white border-t border-gs-ink/10",
]} transition:animate="fade">
  <div class="max-w-7xl mx-auto px-6">
    <div class="flex flex-col items-center md:flex-row md:items-center md:justify-between gap-4 md:gap-3">
      <div class="flex flex-col md:flex-row items-center gap-3 md:gap-3">
        <Isotype class="w-12 h-12 md:w-10 md:h-10 text-gs-ink" />
        <p class="text-xs md:text-base font-body text-gs-ink text-center md:text-left">
          Copyright &copy; 2026 {COMPANY.name}. Todos los derechos reservados.
        </p>
      </div>

      <div class="flex items-center gap-4">
        <a href="#" aria-label="LinkedIn" class="text-gs-ink/40 hover:text-gs-ink transition-colors">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
            <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
          </svg>
        </a>
        <a href="#" aria-label="Instagram" class="text-gs-ink/40 hover:text-gs-ink transition-colors">
          <Instagram size={24} weight="Filled"  />
        </a>
      </div>
    </div>
  </div>
</footer>
