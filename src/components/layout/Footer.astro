---
import { Instagram, Globe } from "reicon-react";
import { COMPANY } from "../../lib/constants";
---

<footer class="bg-gs-ink text-white/50 py-10">
  <div class="max-w-7xl mx-auto px-6 flex flex-col md:flex-row items-center justify-between gap-6">
    <div class="flex items-center gap-3">
      <div class="w-8 h-8 rounded-full bg-gs-crimson flex items-center justify-center">
        <span class="text-white font-display font-bold text-sm">GS</span>
      </div>
      <p class="text-sm font-body">
        Copyright &copy; 2026 {COMPANY.name}. Todos los derechos reservados.
      </p>
    </div>

    <div class="flex items-center gap-4">
      <a href="#" aria-label="LinkedIn" class="hover:text-white transition-colors">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
          <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
        </svg>
      </a>
      <a href="#" aria-label="Instagram" class="hover:text-white transition-colors">
        <Instagram size={20} />
      </a>
      <a href="#" aria-label="GitHub" class="hover:text-white transition-colors">
        <Globe size={20} />
      </a>
    </div>
  </div>
</footer>
